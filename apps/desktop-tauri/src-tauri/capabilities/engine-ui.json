{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "engine-ui",
  "description": "The engine UI windows (win-*: the Homepage, creation and one per organization) at http://127.0.0.1. It renders agent-written HTML and Markdown, so it gets only the orgtreeDesktop bridge commands: no core plugins, shell, fs or process. Each command also checks the exact engine origin in Rust.",
  "windows": [
    "win-*"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "allow-desktop-app-version",
    "allow-desktop-status",
    "allow-desktop-window-state",
    "allow-desktop-window-controls-state",
    "allow-desktop-preferences",
    "allow-desktop-set-preferences",
    "allow-desktop-show",
    "allow-desktop-quit",
    "allow-desktop-window-minimize",
    "allow-desktop-window-toggle-maximize",
    "allow-desktop-window-close",
    "allow-desktop-harnesses",
    "allow-desktop-notify",
    "allow-desktop-sync-notifications",
    "allow-desktop-pending-attention",
    "allow-desktop-open-harness",
    "allow-desktop-reveal-file",
    "allow-desktop-open-charter-folder",
    "allow-desktop-provider-login-start",
    "allow-desktop-provider-login-status",
    "allow-desktop-provider-login-code",
    "allow-desktop-provider-login-cancel",
    "allow-desktop-set-effective-theme",
    "allow-desktop-window-identity",
    "allow-desktop-open-homepage-window",
    "allow-desktop-open-create-window",
    "allow-desktop-cancel-creation",
    "allow-desktop-request-org",
    "allow-desktop-bind-created-org",
    "allow-desktop-set-unsaved-creation",
    "allow-desktop-open-orgs",
    "allow-desktop-take-pending-events",
    "allow-desktop-maintenance-status",
    "allow-desktop-update-status",
    "allow-desktop-check-updates",
    "allow-desktop-install-update",
    "allow-desktop-update-capability",
    "allow-desktop-popout-state",
    "allow-desktop-popout-minimize",
    "allow-desktop-popout-toggle-maximize",
    "allow-desktop-popout-close",
    "allow-desktop-popout-focus"
  ]
}
