{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orgtree Tauri Spike",
  "version": "0.0.1",
  "identifier": "com.kushro.orgtree.tauri-spike",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orgtree (Tauri spike)",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Kushro",
    "shortDescription": "Orgtree desktop shell on Tauri 2 (migration spike)",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
